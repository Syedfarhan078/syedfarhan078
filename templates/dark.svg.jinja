<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ svg_width }} {{ svg_height }}" width="100%" height="100%">
  <defs>
    <!-- Monospace Fonts Import -->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&amp;family=Fira+Code:wght@400;500;700&amp;display=swap');
    </style>

    <!-- Glowing Filters -->
    <filter id="glow-accent" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComponentTransfer in="blur" result="glow">
        <feFuncA type="linear" slope="0.5" />
      </feComponentTransfer>
      <feMerge>
        <feMergeNode in="glow" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Native SVG Typing Animation Clips -->
    <clipPath id="name-clip">
      <rect x="360" y="50" width="0" height="40">
        <animate attributeName="width" from="0" to="350" dur="2s" fill="freeze" />
      </rect>
    </clipPath>
    <clipPath id="title-clip">
      <rect x="360" y="80" width="0" height="30">
        <animate attributeName="width" from="0" to="400" begin="1.8s" dur="1.8s" fill="freeze" />
      </rect>
    </clipPath>
    <clipPath id="subtitle-clip">
      <rect x="360" y="105" width="0" height="25">
        <animate attributeName="width" from="0" to="500" begin="3.2s" dur="2s" fill="freeze" />
      </rect>
    </clipPath>

    <!-- Header Gradient -->
    <linearGradient id="header-grad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="{{ theme.terminal_bg }}" />
      <stop offset="100%" stop-color="{{ theme.background }}" />
    </linearGradient>
  </defs>

  <style>
    /* Styling & Animations */
    .terminal-window {
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }
    .text-mono {
      font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace;
    }
    
    /* Blinking Cursor Animation */
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .cursor {
      animation: blink 1s infinite;
      fill: {{ theme.cursor }};
    }

    /* Subtle Border Glow Pulse */
    @keyframes pulse-border {
      0%, 100% { stroke: {{ theme.border }}; }
      50% { stroke: {{ theme.accent }}; }
    }
    .active-border {
      animation: pulse-border 8s infinite ease-in-out;
    }

    /* Hover States (Monospace-friendly styles) */
    .window-btn {
      transition: transform 0.2s ease;
    }
    .window-btn:hover {
      transform: scale(1.15);
    }
    
    .project-card {
      transition: opacity 0.2s ease-in-out;
      cursor: pointer;
    }
    .project-card:hover {
      opacity: 0.85;
    }
    .project-card:hover .project-title {
      fill: {{ theme.accent_green }};
      filter: url(#glow-accent);
    }
    
    .tech-badge {
      transition: all 0.2s ease-in-out;
    }
    .tech-badge:hover .badge-border {
      stroke: {{ theme.accent }};
      stroke-width: 1.25px;
      fill: {{ theme.border }};
    }
  </style>

  <!-- Main Terminal Window Frame -->
  <rect x="5" y="5" width="940" height="570" rx="10" fill="{{ theme.terminal_bg }}" stroke="{{ theme.border }}" stroke-width="1.5" class="terminal-window active-border" />

  <!-- Window Title Bar -->
  <path d="M 5,15 A 10,10 0 0 1 15,5 L 935,5 A 10,10 0 0 1 945,15 L 945,38 L 5,38 Z" fill="url(#header-grad)" stroke="{{ theme.border }}" stroke-width="1" />
  
  <!-- Window Controls (macOS style) -->
  <g class="window-btn" transform="translate(20, 21.5)">
    <circle cx="0" cy="0" r="6" fill="{{ theme.window_control.close }}" />
    <circle cx="18" cy="0" r="6" fill="{{ theme.window_control.minimize }}" />
    <circle cx="36" cy="0" r="6" fill="{{ theme.window_control.maximize }}" />
  </g>

  <!-- Terminal Window Title -->
  <text x="475" y="26" fill="{{ theme.subtext }}" class="text-mono" font-size="12" text-anchor="middle">{{ profile.username }}@windows-desktop: ~</text>

  <!-- ========================================== -->
  <!-- LEFT COLUMN (ASCII, Photo, System Info)    -->
  <!-- ========================================== -->

  <!-- ASCII Art Logo -->
  <g transform="translate(45, 60)">
    <text fill="{{ theme.accent }}" class="text-mono" font-size="12" xml:space="preserve">
      {%- for line in ascii_logo.split('\n') %}
      <tspan x="0" dy="15">{{ line }}</tspan>
      {%- endfor %}
    </text>
  </g>

  <!-- ASCII Photo Feed Sub-Window -->
  <g transform="translate(0, 0)">
    <!-- Window Border frame -->
    <rect x="75" y="190" width="180" height="150" rx="4" fill="none" stroke="{{ theme.border }}" stroke-width="1" />
    <text x="85" y="185" fill="{{ theme.subtext }}" class="text-mono" font-size="9" font-weight="bold">[ PHOTO FEED ]</text>
    
    <!-- Rendered ASCII portrait -->
    <g transform="translate(102, 198)">
      <text fill="{{ theme.accent }}" class="text-mono" font-size="7.5" font-weight="bold" xml:space="preserve" opacity="0.85">
        {%- for line in profile_ascii.split('\n') %}
        <tspan x="0" dy="8.5">{{ line }}</tspan>
        {%- endfor %}
      </text>
    </g>

    <!-- Glowing horizontal scan laser line -->
    <line x1="76" y1="191" x2="254" y2="191" stroke="{{ theme.accent }}" stroke-width="1.5" opacity="0.45">
      <animate attributeName="y1" values="191; 339; 191" dur="5s" repeatCount="indefinite" />
      <animate attributeName="y2" values="191; 339; 191" dur="5s" repeatCount="indefinite" />
    </line>
  </g>

  <!-- Terminal Shell Status Information -->
  <g transform="translate(40, 360)" class="text-mono" font-size="12" fill="{{ theme.text }}">
    <!-- Prompt Line -->
    <text x="0" y="0">
      <tspan fill="{{ theme.accent }}" font-weight="bold">{{ profile.username }}</tspan>@AIT:~$ neofetch
    </text>
    
    <!-- Host Information -->
    <text x="0" y="24">
      <tspan fill="{{ theme.subtext }}">Host:</tspan> Atria Inst. of Tech
    </text>
    
    <!-- Status Line -->
    <text x="0" y="44">
      <tspan fill="{{ theme.subtext }}">Status:</tspan> <tspan fill="{{ theme.accent_green }}" font-weight="bold">Active</tspan>
    </text>
    
    <!-- Uptime Line -->
    <text x="0" y="64">
      <tspan fill="{{ theme.subtext }}">Uptime:</tspan> 24/7 coding
    </text>

    <!-- Load visual bar -->
    <text x="0" y="84">
      <tspan fill="{{ theme.subtext }}">Load:</tspan> [<tspan fill="{{ theme.accent }}">███████</tspan><tspan fill="{{ theme.border }}">░░░░░</tspan>] 58%
    </text>
  </g>

  <!-- Neofetch Decorative Color Blocks -->
  <g transform="translate(40, 480)">
    <rect x="0" y="0" width="22" height="12" fill="#ff5f56" rx="2" />
    <rect x="28" y="0" width="22" height="12" fill="#ffbd2e" rx="2" />
    <rect x="56" y="0" width="22" height="12" fill="#27c93f" rx="2" />
    <rect x="84" y="0" width="22" height="12" fill="#58a6ff" rx="2" />
    <rect x="112" y="0" width="22" height="12" fill="#cba6f7" rx="2" />
    <rect x="140" y="0" width="22" height="12" fill="#a6e3a1" rx="2" />
    <rect x="168" y="0" width="22" height="12" fill="#8b949e" rx="2" />
  </g>

  <!-- Blinking Shell Prompt Indicator -->
  <g transform="translate(40, 520)" class="text-mono" font-size="12">
    <text x="0" y="0" fill="{{ theme.prompt }}" font-weight="bold">$ <tspan fill="{{ theme.text }}">git commit -m "update"</tspan></text>
    <rect x="195" y="-10" width="8" height="14" class="cursor" />
  </g>

  <!-- ========================================== -->
  <!-- VERTICAL DIVIDER                           -->
  <!-- ========================================== -->
  <line x1="330" y1="38" x2="330" y2="575" stroke="{{ theme.border }}" stroke-width="1.5" />

  <!-- ========================================== -->
  <!-- RIGHT COLUMN (Neofetch details & Content) -->
  <!-- ========================================== -->

  <!-- Profile Header with Monospace and Native Typing reveal -->
  <g class="text-mono">
    <text x="360" y="75" fill="{{ theme.accent }}" font-size="22" font-weight="800" clip-path="url(#name-clip)">{{ profile.name }}</text>
    <text x="360" y="97" fill="{{ theme.text }}" font-size="13" font-weight="600" clip-path="url(#title-clip)">{{ profile.title }}</text>
    <text x="360" y="115" fill="{{ theme.subtext }}" font-size="11.5" font-weight="400" clip-path="url(#subtitle-clip)">{{ profile.subtitle }}</text>
  </g>

  <!-- Dashed Line Divider -->
  <line x1="360" y1="132" x2="910" y2="132" stroke="{{ theme.border }}" stroke-width="1" stroke-dasharray="4 4" />

  <!-- Terminal Info (Neofetch report style) -->
  <g transform="translate(360, 155)" class="text-mono" font-size="12.5" fill="{{ theme.text }}">
    {%- for key, val in terminal_info.items() %}
    {%- set y_offset = loop.index0 * 20 %}
    <text x="0" y="{{ y_offset }}">
      <tspan fill="{{ theme.accent }}" font-weight="bold">{{ key }}</tspan>
      <tspan fill="{{ theme.subtext }}">{{ "." * (14 - key|length) }} </tspan>
      <tspan>{{ val }}</tspan>
    </text>
    {%- endfor %}
  </g>

  <!-- Dashed Line Divider -->
  <line x1="360" y1="322" x2="910" y2="322" stroke="{{ theme.border }}" stroke-width="1" stroke-dasharray="4 4" />

  <!-- Current Focus Section -->
  <text x="360" y="343" fill="{{ theme.accent_green }}" class="text-mono" font-size="12.5" font-weight="bold">> cat focus.txt</text>
  
  <g class="text-mono" font-size="12.5" fill="{{ theme.text }}">
    <!-- Row 1 -->
    <text x="360" y="368"><tspan fill="{{ theme.accent }}">•</tspan> {{ profile.focus[0] }}</text>
    <text x="640" y="368"><tspan fill="{{ theme.accent }}">•</tspan> {{ profile.focus[1] }}</text>
    
    <!-- Row 2 -->
    <text x="360" y="392"><tspan fill="{{ theme.accent }}">•</tspan> {{ profile.focus[2] }}</text>
    <text x="640" y="392"><tspan fill="{{ theme.accent }}">•</tspan> {{ profile.focus[3] }}</text>
  </g>

  <!-- Dashed Line Divider -->
  <line x1="360" y1="412" x2="910" y2="412" stroke="{{ theme.border }}" stroke-width="1" stroke-dasharray="4 4" />

  <!-- Projects Section Header -->
  <text x="360" y="428" fill="{{ theme.accent_yellow }}" class="text-mono" font-size="11.5" font-weight="bold">> cat featured_projects.md</text>

  <!-- 2x2 Grid of Terminal-style Project Cards -->
  {%- for project in projects %}
  {%- set col = loop.index0 % 2 %}
  {%- set row = loop.index0 // 2 %}
  {%- set x = 360 + col * 280 %}
  {%- set y = 438 + row * 43 %}
  <g class="project-card" transform="translate({{ x }}, {{ y }})">
    <a href="https://github.com/{{ profile.username }}/{{ project.name | replace(' ', '-') | replace(' → ', '-') | lower }}" target="_blank">
      <!-- Clickable transparent overlay -->
      <rect width="270" height="36" fill="transparent" />
      <text x="0" y="14" fill="{{ theme.accent }}" class="text-mono project-title" font-size="11.5" font-weight="bold">[✔] {{ project.name }}</text>
      <text x="24" y="27" fill="{{ theme.subtext }}" class="text-mono" font-size="9.5">{{ project.tech }}</text>
    </a>
  </g>
  {%- endfor %}

  <!-- Tech Stack Grid (16 badges, 8 cols x 2 rows) -->
  {%- for tech in tech_stack %}
  {%- set col = loop.index0 % 8 %}
  {%- set row = loop.index0 // 8 %}
  {%- set x = 360 + col * 70 %}
  {%- set y = 528 + row * 21 %}
  <g class="tech-badge" transform="translate({{ x }}, {{ y }})">
    <rect width="64" height="17" rx="3.5" fill="{{ theme.terminal_bg }}" stroke="{{ theme.border }}" stroke-width="1" class="badge-border" />
    <text x="32" y="11.5" fill="{{ theme.text }}" class="text-mono" font-size="9" text-anchor="middle" font-weight="bold">{{ tech }}</text>
  </g>
  {%- endfor %}
</svg>
